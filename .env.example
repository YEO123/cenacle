# Copier ce fichier en .env puis remplir les valeurs
ADMIN_USER=admin
# 12 caractères minimum
ADMIN_PASSWORD=
# URL publique du site, utilisée par le QR code et le cookie sécurisé (ex : https://inscription.mondomaine.fr)
PUBLIC_URL=
# Mettre 1 si l'application est derrière un reverse proxy (Caddy, Nginx…)
TRUST_PROXY=0
# Port exposé sur la machine (3000 par défaut)
APP_PORT=3000
